/font&gt; tham chiếu logic sang service khác (KHÔNG có FK)&lt;br/&gt;[UQ] unique &amp;nbsp;·&amp;nbsp; [NULL] cho phép null &amp;nbsp;·&amp;nbsp; nhãn cạnh = hành vi ON DELETE&lt;br/&gt;Tiền: &lt;b&gt;bigint VND&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Mỗi DB đều có thêm bảng &lt;b&gt;outbox&lt;/b&gt; + &lt;b&gt;inbox&lt;/b&gt; (xem trang Hạ tầng)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;rounded=1;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="80" as="geometry"/></mxCell><mxCell id="svc_catalog_tb_artworks_3" value="artworks" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=1;arcSize=4;fillColor=#d97706;fontColor=#ffffff;strokeColor=#d97706;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="380" height="712" as="geometry"/></mxCell><mxCell id="svc_catalog_r_4" value="PK  id: uuid" style="text;html=1;strokeColor=none;fillColor=#fef3c7;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;fontStyle=1;" vertex="1" parent="svc_catalog_tb_artworks_3"><mxGeometry y="30" width="380" height="22" as="geometry"/></mxCell><mxCell id="svc_catalog_r_5" value="REF seller_id: uuid  → identity.users" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;fontColor=#7c3aed;fontStyle=2;" vertex="1" parent="svc_catalog_tb_artworks_3"><mxGeometry y="52" width="380" height="22" as="geometry"/></mxCell><mxCell id="svc_catalog_r_6" value="FK  folder_id: uuid  [NULL]" style="text;html=1;strokeColor=none;fillColor=none;align=left;v