agram><diagram id="svc_social" name="4. Social Service (social_db)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="svc_social_t_1" value="&lt;b style=&#x27;font-size:20px;color:#db2777&#x27;&gt;SOCIAL SERVICE&lt;/b&gt; &lt;span style=&#x27;color:#64748b&#x27;&gt;— database &lt;b&gt;social_db&lt;/b&gt; · port 3004&lt;/span&gt;&lt;br/&gt;Cộng đồng (follow, reaction, comment, moment, moodboard, review), sự kiện, nhắn tin, thông báo (in-app + email)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell><mxCell id="svc_social_t_2" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;br/&gt;&lt;b&gt;PK&lt;/b&gt; khóa chính &amp;nbsp;·&amp;nbsp; &lt;b&gt;PF&lt;/b&gt; vừa PK vừa FK &amp;nbsp;·&amp;nbsp; &lt;font color=&#x27;#1d4ed8&#x27;&gt;FK&lt;/font&gt; khóa ngoại vật lý (cùng DB) &amp;nbsp;·&amp;nbsp; &lt;font color=&#x27;#7c3aed&#x27;&gt;&lt;i&gt;REF&lt;/i&gt;&lt;/font&gt; tham chiếu logic sang service khác (KHÔNG có FK)&lt;br/&gt;[UQ] unique &amp;nbsp;·&amp;nbsp; [NULL] cho phép null &amp;nbsp;·&amp;nbsp; nhãn cạnh = hành vi ON DELETE&lt;br/&gt;Tiền: &lt;b&gt;bigint VND&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Mỗi DB đều có thêm bảng &lt;b&gt;outbox&lt;/b&gt; + &lt;b&gt;inbox&lt;/b&gt; (xem trang Hạ tầng)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;rounded=1;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="80" as="geometry"/></mxCell><mxCell id="svc_social_tb_follows_3" value="follows" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=1;arcSize=4