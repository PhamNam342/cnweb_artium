l=1;dashed=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=10;labelBackgroundColor=#ffffff;curved=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="overview_svc_social_36" target="overview_svc_identity_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="overview_re_77" value="REF artworks" style="endArrow=open;html=1;dashed=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=10;labelBackgroundColor=#ffffff;curved=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="overview_svc_social_36" target="overview_svc_catalog_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="overview_re_78" value="REF order_items" style="endArrow=open;html=1;dashed=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=10;labelBackgroundColor=#ffffff;curved=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="overview_svc_social_36" target="overview_svc_commerce_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="overview_re_79" value="REF users" style="endArrow=open;html=1;dashed=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=10;labelBackgroundColor=#ffffff;curved=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="overview_svc_crm_57" target="overview_svc_identity_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="overview_re_80" value="REF artworks" style="endArrow=open;html=1;dashed=1;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=10;labelBackgroundColor=#ffffff;curved=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="overview_svc_crm_57" target="overview_svc_catalog_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="overview_t_81" value="&lt;b&gt;EVENT CHÍNH&lt;/b&gt;&lt;br/&gt;&lt;b&gt;identity.user.registered&lt;/b&gt; — identity → social (tạo user_summary, gửi email chào mừng)&lt;br/&gt;&lt;b&gt;identity.user.updated&lt;/b&gt; — identity → social, catalog (cập nhật projection)&lt;br/&gt;&lt;b&gt;identity.email_verification.requested&lt;/b&gt; — identity → identity.mailer (gửi email xác minh qua SMTP; sau này chuyển sang social)&lt;br/&gt;&lt;b&gt;identity.password_reset.requested&lt;/b&gt; — identity → identity.mailer (gửi email đặt lại mật khẩu qua SMTP; sau này chuyển sang social)&lt;br/&gt;&lt;b&gt;identity.seller_profile.upserted&lt;/b&gt; — identity → catalog (seller_summaries), social (user_summaries)&lt;br/&gt;&lt;b&gt;catalog.artwork.published / updated / archived&lt;/b&gt; — catalog → social (artwork_summaries), commerce (vô hiệu giỏ hàng nếu ngừng bán)&lt;br/&gt;&lt;b&gt;catalog.reservation.failed&lt;/b&gt; — catalog → commerce (hủy đơn vì hết hàng)&lt;br/&gt;&lt;b&gt;commerce.order.created&lt;/b&gt; — commerce → catalog (tạo reservation)&lt;br/&gt;&lt;b&gt;commerce.order.paid&lt;/b&gt; — commerce → catalog (confirm reservation), crm (cập nhật contact), social (thông báo seller + buyer)&lt;br/&gt;&lt;b&gt;commerce.order.cancelled&lt;/b&gt; — commerce → catalog (release reservation), social (thông báo)&lt;br/&gt;&lt;b&gt;commerce.seller_order.shipped / delivered&lt;/b&gt; — commerce → social (thông báo buyer)&lt;br/&gt;&lt;b&gt;social.reaction.changed / social.comment.changed&lt;/b&gt; — social → catalog (like_count, comment_count)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#fff7ed;strokeColor=#fdba74;rounded=1;spacing=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="1500" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="svc_identity" name="1. Identity Service (identity_db)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="svc_identity_t_1" value="&lt;b style=&#x27;font-size:20px;color:#2563eb&#x27;&gt;IDENTITY SERVICE&lt;/b&gt; &lt;span style=&#x27;color:#64748b&#x27;&gt;— database &lt;b&gt;identity_db&lt;/b&gt; · port 3001&lt;/span&gt;&lt;br/&gt;Tài khoản, xác thực (email/mật khẩu + Google), phiên đăng nhập, hồ sơ người bán." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell><mxCell id="svc_identity_t_2" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;br/&gt;&lt;b&gt;PK&lt;/b&gt; khóa chính &amp;nbsp;·&amp;nbsp; &lt;b&gt;PF&lt;/b&gt; vừa PK vừa FK &amp;nbsp;·&amp;nbsp; &lt;font color=&#x27;#1d4ed8&#x27;&gt;FK&lt;/font&gt; khóa ngoại vật lý (cùng DB) &amp;nbsp;·&amp;nbsp; &lt;font color=&#x27;#7c3aed&#x27;&gt;&lt;i&gt;REF&lt;/i&gt;&lt;/font&gt; tham chiếu logic sang service khác (KHÔNG có FK)&lt;br/&gt;[UQ] unique &amp;nbsp;·&amp;nbsp; [NULL] cho phép null &amp;nbsp;·&amp;nbsp; nhãn cạnh = hành vi ON DELETE&lt;br/&gt;Tiền: &lt;b&gt;bigint VND&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Mỗi DB đều có thêm bảng &lt;b&gt;outbox&lt;/b&gt; + &lt;b&gt;inbox&lt;/b&gt; (xem trang Hạ tầng)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;rounded=1;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="80" as="geometry"/></mxCell><mxCell id="svc_identity_tb_users_3" value="users" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;rounded=1;arcSize=4;fillColor=#2563eb;fontColor=#ffffff;strokeColor=#2563eb;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="380" height="382" as="geometry"/></mxCell><mxCell id="svc_identity_r_4" value="PK  id: uuid" style="text;html=1;strokeColor=none;fillColor=#dbeafe;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;fontStyle=1;" vertex="1" parent="svc_identity_tb_users_3"><mxGeometry y="30" width="380" height="22" as="geometry"/></mxCell><mxCell id="svc_identity_r_5" value="      email: varchar(320)  [UQ]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;" vertex="1" parent="svc_identity_tb_users_3"><mxGeometry y="52" width="380" height="22" as="geometry"/></mxCell><mxCell id="svc_identity_r_6" value="      password_hash: varchar(255)  [NULL]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;" vertex="1" parent="svc_identity_tb_users_3"><mxGeometry y="74" width="380" height="22" as="geometry"/></mxCell><mxCell id="svc_identity_r_7" value="      full_name: varchar(255)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;" vertex="1" parent="svc_identity_tb_users_3"><mxGeometry y="96" width="380" height="22" as="geometry"/></mxCell><mxCell id="svc_identity_r_8" value="      avatar_url: varchar(1024)  [NULL]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier New;fontSize=11;" vertex="1" parent="svc_identity_tb_users_3"><mxGeometry y="118" width="380" height="22" as="geometry"/></mxCell><mxCell id="svc_identity_r_9" value="      phone: varchar(20)  [NULL]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Courier Ne