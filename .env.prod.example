# Production (docker-compose.prod.yml). Copy thành .env ở thư mục gốc.
POSTGRES_USER=artium
POSTGRES_PASSWORD=change_me_to_a_strong_password
RABBITMQ_USER=artium
RABBITMQ_PASSWORD=change_me_to_a_strong_password
FRONTEND_PORT=80
WEB_ORIGIN=https://your-domain.vn
COOKIE_SECURE=true
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Artium <your-gmail@gmail.com>"
