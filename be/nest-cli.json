{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/identity",
  "sourceRoot": "apps/identity/src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "plugins": [{ "name": "@nestjs/swagger", "options": { "introspectComments": true } }]
  },
  "projects": {
    "gateway": { "type": "application", "root": "apps/gateway", "entryFile": "apps/gateway/src/main", "sourceRoot": "apps/gateway/src", "compilerOptions": { "tsConfigPath": "apps/gateway/tsconfig.app.json" } },
    "identity": { "type": "application", "root": "apps/identity", "entryFile": "apps/identity/src/main", "sourceRoot": "apps/identity/src", "compilerOptions": { "tsConfigPath": "apps/identity/tsconfig.app.json" } },
    "catalog": { "type": "application", "root": "apps/catalog", "entryFile": "apps/catalog/src/main", "sourceRoot": "apps/catalog/src", "compilerOptions": { "tsConfigPath": "apps/catalog/tsconfig.app.json" } },
    "commerce": { "type": "application", "root": "apps/commerce", "entryFile": "apps/commerce/src/main", "sourceRoot": "apps/commerce/src", "compilerOptions": { "tsConfigPath": "apps/commerce/tsconfig.app.json" } },
    "social": { "type": "application", "root": "apps/social", "entryFile": "apps/social/src/main", "sourceRoot": "apps/social/src", "compilerOptions": { "tsConfigPath": "apps/social/tsconfig.app.json" } },
    "crm": { "type": "application", "root": "apps/crm", "entryFile": "apps/crm/src/main", "sourceRoot": "apps/crm/src", "compilerOptions": { "tsConfigPath": "apps/crm/tsconfig.app.json" } },
    "common": { "type": "library", "root": "libs/common", "entryFile": "index", "sourceRoot": "libs/common/src", "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" } },
    "database": { "type": "library", "root": "libs/database", "entryFile": "index", "sourceRoot": "libs/database/src", "compilerOptions": { "tsConfigPath": "libs/database/tsconfig.lib.json" } },
    "messaging": { "type": "library", "root": "libs/messaging", "entryFile": "index", "sourceRoot": "libs/messaging/src", "compilerOptions": { "tsConfigPath": "libs/messaging/tsconfig.lib.json" } },
    "contracts": { "type": "library", "root": "libs/contracts", "entryFile": "index", "sourceRoot": "libs/contracts/src", "compilerOptions": { "tsConfigPath": "libs/contracts/tsconfig.lib.json" } },
    "storage": { "type": "library", "root": "libs/storage", "entryFile": "index", "sourceRoot": "libs/storage/src", "compilerOptions": { "tsConfigPath": "libs/storage/tsconfig.lib.json" } }
  }
}
