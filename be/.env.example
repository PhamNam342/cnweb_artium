# ============================================================
# Artium backend — file env dùng chung cho mọi service khi dev.
# Copy thành be/.env. Service đọc <SERVICE>_DATABASE_URL / <SERVICE>_PORT
# (hoặc đặt DATABASE_URL / PORT trực tiếp trong apps/<service>/.env).
# ============================================================
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# ---- Cổng ----
GATEWAY_PORT=3000
IDENTITY_PORT=3001
CATALOG_PORT=3002
COMMERCE_PORT=3003
SOCIAL_PORT=3004
CRM_PORT=3005

# ---- Gateway: địa chỉ các service ----
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
COMMERCE_URL=http://localhost:3003
SOCIAL_URL=http://localhost:3004
CRM_URL=http://localhost:3005

# ---- PostgreSQL: mỗi service một database (docker-compose tự tạo) ----
IDENTITY_DATABASE_URL=postgresql://artium:artium_dev@localhost:55432/identity_db
CATALOG_DATABASE_URL=postgresql://artium:artium_dev@localhost:55432/catalog_db
COMMERCE_DATABASE_URL=postgresql://artium:artium_dev@localhost:55432/commerce_db
SOCIAL_DATABASE_URL=postgresql://artium:artium_dev@localhost:55432/social_db
CRM_DATABASE_URL=postgresql://artium:artium_dev@localhost:55432/crm_db
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# ---- RabbitMQ / Redis ----
RABBITMQ_URL=amqp://artium:artium_dev@localhost:5672
REDIS_URL=redis://localhost:6379
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000

# ---- Auth (JWT_ACCESS_SECRET phải GIỐNG NHAU ở mọi service) ----
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Ân hạn (giây) khi nhiều tab refresh cùng lúc; 0 = tắt
REFRESH_REUSE_GRACE_SECONDS=10
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
COOKIE_SECURE=false

# ---- Google login: Client ID loại "Web application" ở Google Cloud Console ----
GOOGLE_CLIENT_ID=

# ---- PayOS (commerce, dùng ở bước sau) — lấy tại https://my.payos.vn ----
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ---- Email (SMTP) — identity gửi mail xác minh / đặt lại mật khẩu ----
# Dev: Mailpit trong docker-compose (xem mail tại http://localhost:8025)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=<gmail>, SMTP_PASS=<App Password>
# Để trống SMTP_HOST => nội dung mail chỉ in ra log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Artium <no-reply@artium.local>"

# ---- Cloudinary (catalog: ảnh tác phẩm) — Cloudinary Console → Dashboard → API Keys ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=artium
